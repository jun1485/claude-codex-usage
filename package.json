{
  "name": "claude-codex-usage-monitor",
  "displayName": "Claude Code Usage & Codex Usage",
  "description": "%ext.description%",
  "version": "0.2.0",
  "publisher": "jjju",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/jun1485/claude-codex-usage.git"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=jjju.claude-codex-usage-monitor",
  "bugs": {
    "url": "https://github.com/jun1485/claude-codex-usage/issues"
  },
  "icon": "assets/marketplace-icon.png",
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude usage",
    "claude code",
    "claude code usage",
    "claude usage monitor",
    "claude rate limit",
    "claude quota",
    "codex usage",
    "codex cli",
    "codex cli usage",
    "codex usage monitor",
    "codex rate limit",
    "codex quota",
    "claude codex usage",
    "usage monitor",
    "rate limit monitor",
    "quota monitor",
    "ai usage",
    "status bar",
    "statusbar",
    "anthropic",
    "openai",
    "vscode",
    "cursor",
    "cursor extension",
    "windsurf",
    "windsurf extension",
    "vscodium",
    "open vsx",
    "클로드 사용량",
    "코덱스 사용량"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "claude-usage-logo": {
        "description": "Claude logo",
        "default": {
          "fontPath": "./assets/usage-icons.woff",
          "fontCharacter": "\\E900"
        }
      },
      "codex-usage-logo": {
        "description": "Codex (OpenAI) logo",
        "default": {
          "fontPath": "./assets/usage-icons.woff",
          "fontCharacter": "\\E901"
        }
      }
    },
    "commands": [
      {
        "command": "claudeCodexUsage.refresh",
        "title": "%cmd.refresh.title%",
        "category": "Claude & Codex Usage"
      },
      {
        "command": "claudeCodexUsage.openSettings",
        "title": "%cmd.openSettings.title%",
        "category": "Claude & Codex Usage"
      },
      {
        "command": "claudeCodexUsage.openMenu",
        "title": "%cmd.openMenu.title%",
        "category": "Claude & Codex Usage"
      }
    ],
    "configuration": {
      "title": "Claude & Codex Usage",
      "properties": {
        "claudeCodexUsage.warningThreshold": {
          "type": "number",
          "default": 80,
          "order": 1,
          "description": "%cfg.warningThreshold%"
        },
        "claudeCodexUsage.errorThreshold": {
          "type": "number",
          "default": 95,
          "order": 2,
          "description": "%cfg.errorThreshold%"
        },
        "claudeCodexUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "order": 3,
          "description": "%cfg.refreshInterval%"
        },
        "claudeCodexUsage.displayMode": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "enumDescriptions": [
            "%cfg.displayMode.compact%",
            "%cfg.displayMode.full%"
          ],
          "default": "compact",
          "order": 4,
          "description": "%cfg.displayMode%"
        },
        "claudeCodexUsage.claude.enabled": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "%cfg.claude.enabled%"
        },
        "claudeCodexUsage.claude.credentialsPath": {
          "type": "string",
          "default": "",
          "order": 6,
          "description": "%cfg.claude.credentialsPath%"
        },
        "claudeCodexUsage.codex.enabled": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "%cfg.codex.enabled%"
        },
        "claudeCodexUsage.codex.sessionsPath": {
          "type": "string",
          "default": "",
          "order": 8,
          "description": "%cfg.codex.sessionsPath%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
